{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stackfund.dev/schemas/crowd_scenario_report.schema.json",
  "title": "CrowdScenarioReport",
  "description": "Pro report payload. Root non_authoritative is const true; no authoritative market/action fields; the only decision-shaped output is a categorical narrative_divergence (no scalar). A disclaimer is mandatory (fail-closed).",
  "type": "object",
  "additionalProperties": false,
  "required": ["non_authoritative", "scenario", "reaction_chain", "persona_samples", "narrative_divergence", "disclaimer"],
  "properties": {
    "non_authoritative": { "const": true },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "seed": { "type": "integer" },
        "deterministic_core": { "const": true },
        "model": { "type": "string" }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario_id", "label"],
      "properties": {
        "scenario_id": { "type": "string" },
        "label": { "type": "string" },
        "shock_description": { "type": "string" },
        "horizon": { "type": "string" }
      }
    },
    "reaction_chain": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order", "mechanism", "narrative"],
        "properties": {
          "order": { "type": "integer" },
          "trigger_archetype": { "type": "string" },
          "reacting_archetype": { "type": "string" },
          "mechanism": { "type": "string" },
          "narrative": { "type": "string" }
        }
      }
    },
    "persona_samples": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["archetype_id", "stance", "is_synthetic"],
        "properties": {
          "archetype_id": { "type": "string" },
          "stance": { "type": "integer", "enum": [-1, 0, 1] },
          "register": { "type": "string" },
          "excerpt": { "type": "string" },
          "is_synthetic": { "const": true }
        }
      }
    },
    "narrative_divergence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["crowd_consensus", "engine_posture", "divergence_bucket", "narrative_intensity", "non_authoritative"],
      "properties": {
        "crowd_consensus": { "enum": ["bearish", "neutral", "bullish"] },
        "engine_posture": { "enum": ["bearish", "neutral", "bullish"] },
        "divergence_bucket": { "enum": ["LOW", "MEDIUM", "HIGH"] },
        "narrative_intensity": { "enum": [1, 2, 3] },
        "non_authoritative": { "const": true }
      }
    },
    "data_completeness": { "enum": ["full", "partial"] },
    "disclaimer": { "type": "string", "minLength": 40 }
  }
}
