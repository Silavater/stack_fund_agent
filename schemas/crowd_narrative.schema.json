{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stackfund.dev/schemas/crowd_narrative.schema.json",
  "title": "CrowdNarrative",
  "description": "The ONLY object L3 may emit. Categorical crowd stance + narrative; NO numeric modifier and no price/nav/yield/weight/cap fields. Hard-wired non_authoritative.",
  "type": "object",
  "additionalProperties": false,
  "required": ["seed_id", "rng_seed", "n_personas", "crowd_consensus", "non_authoritative"],
  "properties": {
    "seed_id": { "type": "string" },
    "rng_seed": { "type": "integer" },
    "n_personas": { "type": "integer", "minimum": 0, "maximum": 50 },
    "crowd_consensus": { "enum": ["bearish", "neutral", "bullish"] },
    "non_authoritative": { "const": true },
    "synthetic_population": { "const": true },
    "artifact_type": { "const": "CrowdNarrative" },
    "narrative_md": { "type": "string" },
    "persona_samples": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["archetype_id", "stance", "is_synthetic"],
        "properties": {
          "archetype_id": { "type": "string" },
          "stance": { "type": "integer", "enum": [-1, 0, 1] },
          "register": { "type": "string" },
          "excerpt": { "type": "string" },
          "is_synthetic": { "const": true }
        }
      }
    }
  }
}
