# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.import_linter_cache/
build/
dist/

# uv
# (uv.lock IS committed — it pins the deterministic build)

# Secrets — NEVER commit real keys. Only *.example templates are tracked.
secrets/*.txt
!secrets/*.example
.env
*.env
!*.env.example

# Hermes agent state (mounted at /opt/data at runtime)
.hermes/
.hermes-data/
# Runtime agent env (holds the real LLM key) — only agent.env.example is tracked
docker/agent.env

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Local preview config (holds a machine-specific absolute path)
.claude/launch.json

# Sibling projects kept locally inside the repo for reference, NOT part of StackFund
# (ST = Chen YuShen's stock_agent, analysed + selectively ported — see NOTICE).
ST/
hermes-src-tmp/
