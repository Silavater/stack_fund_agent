{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stackfund/etf_research_report",
  "title": "StackFund ETF research report — full deterministic pipeline result",
  "type": "object",
  "required": ["meta", "etfs", "finops", "portfolio"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["scenario", "seed", "run_id", "formula_version", "as_of"],
      "properties": {
        "scenario": { "type": "string" },
        "seed": { "type": "integer" },
        "run_id": { "type": "string" },
        "formula_version": { "type": "string" },
        "as_of": { "type": "string" }
      }
    },
    "etfs": { "type": "array", "description": "decisions — validated in detail by rebalance_plan" },
    "finops": {
      "type": "object",
      "required": ["revenue", "cost", "gross_margin"],
      "properties": {
        "revenue": { "type": "number" },
        "cost": { "type": "number" },
        "gross_margin": { "type": "number" },
        "refused": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["reason"],
            "properties": { "reason": { "type": "string" } }
          }
        }
      }
    },
    "portfolio": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "symbol": { "type": "string" },
          "action": { "type": "string" },
          "delta_pp": { "type": "number" }
        }
      }
    },
    "experiment": { "type": "object" }
  }
}
