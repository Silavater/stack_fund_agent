{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stackfund/crowd_narrative",
  "title": "StackFund crowd narrative (FACE) — non-authoritative, firewalled",
  "description": "additionalProperties:false is firewall teeth: NO numeric/decision-shaped scalar may appear; the consensus is categorical and non_authoritative is hard true.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "seed_id",
    "artifact_type",
    "crowd_consensus",
    "non_authoritative",
    "synthetic_population",
    "n_personas",
    "narrative_md"
  ],
  "properties": {
    "seed_id": { "type": "string", "minLength": 1 },
    "artifact_type": { "const": "CrowdNarrative" },
    "crowd_consensus": { "enum": ["bearish", "neutral", "bullish"] },
    "non_authoritative": { "const": true },
    "synthetic_population": { "const": true },
    "n_personas": { "type": "integer", "minimum": 0 },
    "narrative_md": { "type": "string" }
  }
}
