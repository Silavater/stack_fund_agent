# Keep the build context (and image) small and secret-free.
.git
.github
.venv
venv
**/__pycache__
*.pyc
.pytest_cache
.ruff_cache
.import_linter_cache
doc
# Secrets must never enter an image layer — inject at runtime instead.
secrets
*.env
.env
# Tests/fixtures are not needed in the lean runtime image.
tests
