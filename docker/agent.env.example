# =============================================================================
# StackFund — Hermes agent runtime env.
#
#   PASTE YOUR KEY BELOW, then:
#     cp docker/agent.env.example docker/agent.env       # docker/agent.env is git-ignored
#
# Injected at RUNTIME via --env-file — never baked into an image layer.
# (Hermes also auto-reads /opt/data/.env; env vars take precedence.)
# =============================================================================

# --- REQUIRED: Hermes model via Nous Portal API key (provider: nous-api) ------
# The hackathon requires a Nous Hermes model. Get an API key from the Nous
# Portal (`hermes portal open`, or https://portal.nousresearch.com).
# >>> PASTE YOUR KEY HERE <<<
NOUS_API_KEY=

# Hermes model id. Confirm the exact id with `hermes model --refresh`.
# Examples: Hermes-4-70B | Hermes-4-405B | Hermes-4-14B
HERMES_MODEL=Hermes-4-70B

# --- OPTIONAL: Stripe earn/spend (use a SANDBOX test key) ---------------------
# STRIPE_SECRET_KEY=rk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# --- OPTIONAL: dashboard on :9119 --------------------------------------------
# HERMES_DASHBOARD=1
